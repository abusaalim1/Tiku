rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /chats/{chatId} {
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow read, update, delete: if signedIn() && request.auth.uid in resource.data.members;

      match /messages/{msgId} {
        allow read, write: if signedIn() && request.auth.uid in
          get(/databases/$(database)/documents/chats/$(chatId)).data.members;

        match /chunks/{chunkId} {
          allow read, write: if signedIn() && request.auth.uid in
            get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }
      }

      match /calls/{callId} {
        allow read, write: if signedIn() && request.auth.uid in
          get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      }
    }

    match /moments/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
      match /items/{itemId} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}