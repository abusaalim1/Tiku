rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      // ROUND 8: a user may release ONLY their own claim (username change —
      // the rename transaction frees the old name while claiming the new
      // one). Nobody can ever delete another user's claim.
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /chats/{chatId} {
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow read, update, delete: if signedIn() && request.auth.uid in resource.data.members;

      match /messages/{msgId} {
        allow read, write: if signedIn() && request.auth.uid in
          get(/databases/$(database)/documents/chats/$(chatId)).data.members;

        match /chunks/{chunkId} {
          allow read, write: if signedIn() && request.auth.uid in
            get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }
      }

      match /calls/{callId} {
        allow read, write: if signedIn() && request.auth.uid in
          get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      }

      // ROUND 35 custom gallery theme asset (rules fix 2026-11-09):
      // the encrypted theme photo lives at themeasset/main (+ chunks),
      // written by setCustomTheme; it was missing here, so every
      // custom-theme write was default-denied.
      match /themeasset/{assetId} {
        allow read, write: if signedIn() && request.auth.uid in
          get(/databases/$(database)/documents/chats/$(chatId)).data.members;

        match /chunks/{chunkId} {
          allow read, write: if signedIn() && request.auth.uid in
            get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }
      }

      // ROUND 60: the live Nikah ceremony session
      // (chats/{chatId}/nikah/session) — plaintext step/presence
      // metadata plus conversation-key-encrypted personal fields;
      // members only, exactly like themeasset above.
      match /nikah/{docId} {
        allow read, write: if signedIn() && request.auth.uid in
          get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      }

      // ROUND 70: shared /babeg game state (chats/{chatId}/gamestate/{msgId}
      // — the game's own JSON board state, written/read via the TikuGame
      // bridge; members only, exactly like messages/themeasset/nikah.
      match /gamestate/{docId} {
        allow read, write: if signedIn() && request.auth.uid in
          get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      }
    }

    match /moments/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
      match /items/{itemId} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ROUND 56 — CONSENT-BASED AI-CHAT SHARING. The owner identity is
    // the token EMAIL, exactly as Config.OWNER_EMAIL defines it in
    // the app. Nothing here touches chats/messages: person-to-person
    // encryption and membership rules above are unchanged.
    function isOwner() {
      return signedIn() && request.auth.token.email == "taiwanserverforff123@gmail.com";
    }

    match /aiShareRequests/{reqId} {
      // Only the owner creates a request, and only as himself.
      allow create: if isOwner()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == "pending";
      // The target reads requests addressed to them; the owner reads his own.
      allow read: if signedIn()
        && (resource.data.toUid == request.auth.uid || isOwner());
      // Only the target decides, only from "pending", and only the
      // decision fields may change.
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && resource.data.status == "pending"
        && request.resource.data.status in ["approved", "declined"]
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["status", "decidedMs"]);
      allow delete: if false;
    }

    match /aiShared/{uid} {
      // A shared copy is written ONLY by the user it belongs to (at
      // their own Approve tap) — never by the owner, never by anyone else.
      allow create, update: if signedIn() && request.auth.uid == uid;
      // Readable by the sharing user and by the owner — nobody else.
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      // Revoke: only the sharing user may delete the copy. The owner cannot.
      allow delete: if signedIn() && request.auth.uid == uid;
    }
  }
}