<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Notification permission for the FCM message/call alerts
         (ROUND 58 — PushAlerts in FcmNotify.kt): the OWNER account is
         always on; every other account shows alerts only while its
         own Notifications toggle is ON (default OFF). Nothing posts
         at toggle time and there is no standing shade entry any more:
         a notification exists only while a real event (message /
         call / app update) stands. ROUND 58 also REMOVED the old
         alert foreground service's permissions (FOREGROUND_SERVICE /
         FOREGROUND_SERVICE_DATA_SYNC) and the Round-49 battery-
         exemption permission (REQUEST_IGNORE_BATTERY_OPTIMIZATIONS)
         — FCM delivery needs neither. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ROUND 32: the media-projection companion of the screen-share
         service below. Inert unless a user in a live call taps
         "Share screen" and grants the system consent dialog. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <application android:name=".TikuApp" android:label="Tiku" android:theme="@style/Theme.Tiku" android:allowBackup="false"
        android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round">
        <!-- Round 4 / Play Protect differential audit: strip the AndroidX
             ProfileInstaller broadcast receiver from the merged manifest.
             It is exported and guarded by the signature-level DUMP
             permission, exists in every Compose app, and serves only
             Play/adb-triggered profile operations — a sideloaded app never
             receives those. The startup INITIALIZER stays, so the baseline
             profile bundled in assets/dexopt still installs locally at
             first run; only the externally-triggerable receiver is removed
             to keep the install surface as small as possible. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />
        <!-- ROUND 15: FileProvider for the composer camera — capture
             targets live in app CACHE only (cap_*.jpg / cap_*.mp4) and are
             never written to the gallery. Not exported; the camera app
             gets a per-intent URI grant only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="tiku.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <activity android:name=".MainActivity" android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- ROUND 58: the FCM receiving service (FcmNotify.kt). Data-
             only pushes from the tiku-notify Worker land here; the
             service gates, decrypts on-device and posts the alert
             itself. Never exported; the MESSAGING_EVENT filter is the
             standard FCM entry point. (This replaces the deleted
             Round-29 TikuAlertService + Round-49 AlertReviveReceiver:
             FCM wakes this service itself, so no foreground service,
             watchdog or standing banner exists any more.) -->
        <service
            android:name=".TikuFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- ROUND 32: screen-share projection service (ScreenShare.kt).
             Never exported, never started outside a live call: it runs
             only while a user is actively sharing their screen, which
             Android 14+ requires a mediaProjection-typed foreground
             service for. -->
        <service
            android:name=".ScreenShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
