<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Notification permission, used ONLY by the opt-in, per-user
         message alerts (OwnerNotify — any account that turns its own
         Notifications toggle on; default OFF). Nothing posts at toggle
         time and nothing stands persistently: since ROUND 20 there is
         no foreground service, so a notification exists only while a
         real event (message / missed call / app update) stands. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <application android:name=".TikuApp" android:label="Tiku" android:theme="@style/Theme.Tiku" android:allowBackup="false"
        android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round">
        <!-- Round 4 / Play Protect differential audit: strip the AndroidX
             ProfileInstaller broadcast receiver from the merged manifest.
             It is exported and guarded by the signature-level DUMP
             permission, exists in every Compose app, and serves only
             Play/adb-triggered profile operations — a sideloaded app never
             receives those. The startup INITIALIZER stays, so the baseline
             profile bundled in assets/dexopt still installs locally at
             first run; only the externally-triggerable receiver is removed
             to keep the install surface as small as possible. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />
        <!-- ROUND 15: FileProvider for the composer camera — capture
             targets live in app CACHE only (cap_*.jpg / cap_*.mp4) and are
             never written to the gallery. Not exported; the camera app
             gets a per-intent URI grant only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="tiku.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <activity android:name=".MainActivity" android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
