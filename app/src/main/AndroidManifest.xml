<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Notification permission, used ONLY by the opt-in, per-user
         message alerts (OwnerNotify — any account that turns its own
         Notifications toggle on; default OFF). Nothing posts at toggle
         time. ROUND 29 (owner's knowing reversal of Round 20): while —
         and only while — an unlocked session has the toggle ON, the
         TikuAlertService foreground service below keeps the alert
         pipeline alive with ONE small permanent silent shade entry;
         every other notification still exists only while a real event
         (message / call / app update) stands. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Foreground-service permissions for TikuAlertService (ROUND 29).
         FOREGROUND_SERVICE_DATA_SYNC is the API-34 typed companion of
         the dataSync service type declared below; both are inert
         unless the service actually starts (unlocked + toggle ON). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- ROUND 49: lets Settings offer the battery-optimization exemption
         for THIS package only (ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS,
         fired from the Settings "Turant notifications" row — never from a
         popup, never automatically). Without the exemption, Doze defers
         the alert service's network and message alerts arrive late even
         on a perfect connection. The permission alone changes nothing;
         only the user's own tap in Settings asks. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- ROUND 32: the media-projection companion of the screen-share
         service below. Inert unless a user in a live call taps
         "Share screen" and grants the system consent dialog. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <application android:name=".TikuApp" android:label="Tiku" android:theme="@style/Theme.Tiku" android:allowBackup="false"
        android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round">
        <!-- Round 4 / Play Protect differential audit: strip the AndroidX
             ProfileInstaller broadcast receiver from the merged manifest.
             It is exported and guarded by the signature-level DUMP
             permission, exists in every Compose app, and serves only
             Play/adb-triggered profile operations — a sideloaded app never
             receives those. The startup INITIALIZER stays, so the baseline
             profile bundled in assets/dexopt still installs locally at
             first run; only the externally-triggerable receiver is removed
             to keep the install surface as small as possible. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />
        <!-- ROUND 15: FileProvider for the composer camera — capture
             targets live in app CACHE only (cap_*.jpg / cap_*.mp4) and are
             never written to the gallery. Not exported; the camera app
             gets a per-intent URI grant only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="tiku.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <activity android:name=".MainActivity" android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- ROUND 29: the alert service (see NotifyService.kt). Never
             exported, never started at boot or before an unlock: it
             runs only inside an unlocked session whose owner turned
             Notifications on, and stops at lock / toggle-off /
             sign-out. dataSync is the standard type for an app
             keeping its own data pipeline in step while closed. -->
        <service
            android:name=".TikuAlertService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- ROUND 49: the alert watchdog's ear. Explicit intents ONLY
             (no intent-filter, never exported): AlarmManager nudges from
             AlertWatchdog (NotifyService.kt) land here when the alert
             service has died while its gate is still on — OEM task
             kills, the dataSync time cap, system stops. The receiver
             re-validates the persisted gate before reviving anything,
             so a stale alarm after lock / toggle-off / sign-out is a
             no-op. Never a boot receiver: the unlock-only lifetime law
             is untouched. -->
        <receiver
            android:name=".AlertReviveReceiver"
            android:exported="false" />
        <!-- ROUND 32: screen-share projection service (ScreenShare.kt).
             Never exported, never started outside a live call: it runs
             only while a user is actively sharing their screen, which
             Android 14+ requires a mediaProjection-typed foreground
             service for. -->
        <service
            android:name=".ScreenShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
